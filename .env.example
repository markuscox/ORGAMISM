# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio / GitHub Actions injects this at runtime from user secrets.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
APP_URL="MY_APP_URL"

# TELEGRAM_BOT_TOKEN: Bot token from @BotFather (never commit real values).
TELEGRAM_BOT_TOKEN="MY_TELEGRAM_BOT_TOKEN"

# TELEGRAM_OWNER_ID: Numeric Telegram user ID of the sole authorized owner.
TELEGRAM_OWNER_ID="MY_TELEGRAM_OWNER_ID"

# ORGANISM_STATE_ENCRYPTION_KEY: 32-byte URL-safe base64 Fernet key used to encrypt persistent state.
ORGANISM_STATE_ENCRYPTION_KEY="MY_FERNET_ENCRYPTION_KEY"

# ORGANISM_ADMIN_TOKEN: Bearer token protecting mutating & private Observatory API endpoints.
ORGANISM_ADMIN_TOKEN="MY_ORGANISM_ADMIN_TOKEN"
